# The address the Vite dev server proxies /api to.
#
# It must match the backend's PORT. Changing one without the other leaves the
# frontend talking to a port nothing is listening on, and the failure looks
# like a network error rather than a configuration mistake.
#
# This is a build-time variable: Vite inlines anything prefixed with VITE_
# into the bundle. It is only used by the dev server and the build - the
# application itself always calls the origin-relative /api path.
VITE_API_TARGET=http://localhost:4000
