# Copy to backend/.env and fill in. Only JWT_SECRET is required to start.

# --- Required -------------------------------------------------------------
# Signs the session cookie. Required in production: the server refuses to
# start without a real one. In development it falls back to a fixed value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- LLM (optional) -------------------------------------------------------
# With no key the project still runs: LLM_MODE defaults to replay, and tests
# and the demo never call a network model. A key is only needed to exercise
# the live provider against the real API instead of the shipped recordings.
GEMINI_API_KEY=

# live = call the provider, replay = read/write the on-disk cache (no network).
LLM_MODE=replay

# Primary model and the fallback tried once if the daily quota is exhausted.
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Lowest tier that still lets the model reason about code.
LLM_REASONING_LEVEL=low

# --- Server (optional) ----------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:5173
# --- Execution (optional) -------------------------------------------------
# Running a checkout's own code is opt-in twice: this flag, and the consent
# on the run itself. It is only needed for the verification step - the two
# test runs that turn "this patch looks right" into "this patch is verified".
ALLOW_REPO_EXECUTION=false
