# Copy to backend/.env and fill in. Only JWT_SECRET is required to start.

# --- Required -------------------------------------------------------------
# Signs the session cookie. The server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- LLM (optional) -------------------------------------------------------
# With no key the project still runs: LLM_MODE defaults to replay, and tests
# and the demo never call a network model. You only need a key for the live
# smoke test in TESTING.md step 7.
GEMINI_API_KEY=

# live = call the provider, replay = read/write the on-disk cache (no network).
LLM_MODE=replay

# Primary model and the fallback tried once if the daily quota is exhausted.
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# Lowest tier that still lets the model reason about code.
LLM_REASONING_LEVEL=low

# --- Server (optional) ----------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:5173