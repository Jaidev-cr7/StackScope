# Copy to backend/.env and fill in. Every setting the backend understands is
# listed here; the ones you do not need are commented out and the code falls
# back to the documented default.
#
# `npm run setup` does this for you: it copies this file, generates a random
# JWT_SECRET and turns on ALLOW_REPO_EXECUTION for local development.

# --- Required -------------------------------------------------------------
# Signs the session cookie. Required in production: the server refuses to
# start without a real one. In development it falls back to a fixed value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Server ----------------------------------------------------------------
# The port the API listens on.
PORT=4000

# development | test | production. `production` enables the JWT_SECRET check
# and marks the session cookie Secure.
NODE_ENV=development

# Comma-separated list of origins allowed to send credentialed requests.
# FRONTEND_ORIGIN is the documented name; CORS_ORIGIN is accepted as an alias,
# so set one or the other - not both.
FRONTEND_ORIGIN=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173

# How long a session lasts, in seconds. Default: 43200 (12 hours).
# JWT_TTL_SECONDS=43200

# The pino log level: trace | debug | info | warn | error | fatal.
# LOG_LEVEL=info

# --- LLM (optional) -------------------------------------------------------
# With no key the project still runs: LLM_MODE defaults to replay, and the
# tests and the demo never call a network model. A key is only needed to
# exercise the live provider against the real API instead of the shipped
# recordings.
GEMINI_API_KEY=

# live = call the provider, replay = read/write the on-disk cache (no network).
LLM_MODE=replay

# Primary model and the fallback tried once if the daily quota is exhausted.
# GEMINI_MODEL wins over LLM_MODEL.
# GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# Lowest tier that still lets the model reason about code.
# LLM_REASONING_LEVEL=low

# Where recorded model responses are kept. Default: <repo>/.cache/llm
# LLM_CACHE_DIR=.cache/llm

# Treat the cache as read-only, so a run can never write a recording.
# LLM_CACHE_READONLY=false

# --- GitHub (optional) ----------------------------------------------------
# live = read the GitHub API, replay = never leave the machine.
# GITHUB_MODE=replay

# Raises the API rate limit and allows private repositories.
# GITHUB_TOKEN=

# Secret for verifying inbound webhook signatures.
# GITHUB_WEBHOOK_SECRET=

# The API base. Default: https://api.github.com
# GITHUB_API_URL=https://api.github.com

# --- Execution (optional) -------------------------------------------------
# Running a checkout's own code is opt-in twice: this flag, and the consent
# on the run itself. It is only needed for the verification step - the two
# test runs that turn "this patch looks right" into "this patch is verified".
ALLOW_REPO_EXECUTION=false

# Budget for a test command, in milliseconds. Default: 300000 (5 minutes).
# EXECUTION_TIMEOUT_MS=300000

# Budget for a dependency install, in milliseconds. Default: 600000 (10 minutes).
# EXECUTION_SETUP_TIMEOUT_MS=600000

# --- Paths (optional) -----------------------------------------------------
# The SQLite database. Default: <backend>/data/app.db
# DATABASE_PATH=backend/data/app.db

# Where disposable checkouts are created. Default: <backend>/.tmp
# SANDBOX_ROOT=backend/.tmp

# --- Tracking (optional) --------------------------------------------------
# The polling window for a tracked workflow, in milliseconds.
# Default: 900000 (15 minutes).
# TRACK_MAX_POLL_MS=900000
