# Local development configuration.
#
# Copy this file to backend/.env and fill in what you need. `npm run setup`
# does that for you: it copies this file, generates a random JWT_SECRET and
# turns on ALLOW_REPO_EXECUTION.
#
# Every setting the backend understands is listed here, grouped by purpose.
# A commented line documents the default without overriding it; an uncommented
# line IS the setting. The defaults below are the ones the code uses when the
# variable is absent, so a line that is commented out and holds its default
# value changes nothing.
#
# For a production deployment use backend/.env.production.example instead -
# it is the same set of variables with the production profile filled in.

# --- Required -------------------------------------------------------------
# Signs the session cookie. Required in production: the server refuses to
# start without a real one, and a secret shorter than 32 characters is
# rejected as well. In development it falls back to a fixed value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Server ----------------------------------------------------------------
# The port the API listens on. The Vite dev server proxies to it; if you
# change it here, change VITE_API_TARGET in frontend/.env to match.
PORT=4000

# development | test | production. `production` enforces the secret checks,
# marks the session cookie Secure, and requires a container runtime before
# repository code may be executed.
NODE_ENV=development

# Comma-separated list of origins allowed to send credentialed requests.
# In production this must be the origin the frontend is served from; the
# server refuses to start if it is still the development one.
FRONTEND_ORIGIN=http://localhost:5173

# How long a session lasts, in seconds. Default: 43200 (12 hours).
# JWT_TTL_SECONDS=43200

# The log level: trace | debug | info | warn | error | fatal | silent.
# Default: info
# LOG_LEVEL=info

# --- LLM ------------------------------------------------------------------
# live = call the provider, replay = serve recorded responses and never make
# a network call. The default is replay, so a checkout with no key works.
LLM_MODE=replay

# The key for the live provider. Only needed when LLM_MODE=live.
# GEMINI_API_KEY=

# The primary model, and the one tried once when the primary is unavailable.
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# How hard the model should think: minimal | low | medium | high.
# Default: low
# LLM_REASONING_LEVEL=low

# Where recorded model responses are kept. Default: <repo>/.cache/llm
# LLM_CACHE_DIR=.cache/llm

# --- GitHub ---------------------------------------------------------------
# live = enable imports, replay = refuse them, so nothing leaves the machine.
# GITHUB_MODE=replay

# A personal access token. Needed for an import to complete: GitHub lets an
# anonymous caller read a run, its jobs and its archive, but refuses the job
# log - and the log is what the analysis is built on.
# `actions:read` is enough for a public repository; `repo` for a private one.
# GITHUB_TOKEN=

# The API base. Point it at a GitHub Enterprise instance to use one.
# Default: https://api.github.com
# GITHUB_API_URL=https://api.github.com

# --- Execution ------------------------------------------------------------
# Running a checkout's own code is opt-in twice: this flag, and the consent
# on the run itself. It is only needed for the verification step - the two
# test runs that turn "this patch looks right" into "this patch is verified".
#
# In production the executor must be a container; the server refuses to start
# with this on and no container runtime available.
ALLOW_REPO_EXECUTION=false

# Budget for a test command, in milliseconds. Default: 300000 (5 minutes).
# EXECUTION_TIMEOUT_MS=300000

# Budget for a dependency install, in milliseconds. Default: 600000 (10 minutes).
# EXECUTION_SETUP_TIMEOUT_MS=600000

# --- Paths ----------------------------------------------------------------
# The SQLite database. Default: <backend>/data/app.db
# DATABASE_PATH=backend/data/app.db

# Where disposable checkouts are created. Default: <backend>/.tmp
# SANDBOX_ROOT=backend/.tmp
