# Production configuration.
#
# Copy this file to backend/.env on the server and fill in the two secrets.
# Every value below is the setting the production profile expects; the ones
# that must be supplied are marked.
#
# The backend refuses to start if any of these is wrong. That is deliberate:
# a production deployment that cannot sign sessions, reach the model, or
# import a run should stop with an explanation rather than serve requests with
# a half-working configuration.
#
# The values that differ from the development profile are the ones that
# matter:
#
#   NODE_ENV=production   enforces the secret checks, marks the session
#                          cookie Secure, and requires a container runtime
#                          before repository code may be executed
#   FRONTEND_ORIGIN       the origin this deployment is served from; the
#                          server refuses to start while it still points at
#                          the development server
#   ALLOW_REPO_EXECUTION  whether patches may be verified by running the
#                          checkout's own test command

# --- Required -------------------------------------------------------------
# Signs the session cookie. Must be at least 32 characters and must not be a
# placeholder. The server refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-secret

# --- Server ----------------------------------------------------------------
# The port the API listens on inside its container.
PORT=4000

# production | development | test
NODE_ENV=production

# The origin the frontend is served from. Comma-separated if there is more
# than one. This must not be the development origin.
FRONTEND_ORIGIN=https://ci-investigator.example.com

# How long a session lasts, in seconds. 43200 is 12 hours.
JWT_TTL_SECONDS=43200

# The log level: trace | debug | info | warn | error | fatal | silent.
# `info` is the right level for a running server; `debug` records a line per
# request.
LOG_LEVEL=info

# --- LLM ------------------------------------------------------------------
# live = call the model, replay = serve recorded responses and never make a
# network call.
#
# Choose `live` for a production deployment that should use the model. It
# requires GEMINI_API_KEY: the server refuses to start with live mode and no
# key, because the model is the product.
LLM_MODE=live

# The key for the provider.
GEMINI_API_KEY=replace-with-your-api-key

# The primary model, and the one tried once when the primary is unavailable
# (a busy provider, an exhausted quota).
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# How hard the model should think: minimal | low | medium | high.
LLM_REASONING_LEVEL=low

# Where recorded model responses are kept. A live run records what the model
# said, so the same input can be answered later without a network call.
# Keep it on a persistent volume: it is part of the application's state.
LLM_CACHE_DIR=/var/lib/ci-investigator/llm-cache

# --- GitHub ---------------------------------------------------------------
# live = enable imports, replay = refuse them so nothing leaves the machine.
#
# Choose `live` for a deployment where importing a failed GitHub Actions run
# is an enabled capability. It requires GITHUB_TOKEN: GitHub refuses the job
# log without one, and the log is what the analysis is built on.
GITHUB_MODE=live

# A personal access token. `actions:read` is enough for public repositories;
# `repo` is needed for private ones. The token is only ever sent to the
# GitHub API and is never returned to the browser.
GITHUB_TOKEN=replace-with-a-personal-access-token

# The API base. Point it at a GitHub Enterprise instance to use one.
GITHUB_API_URL=https://api.github.com

# --- Execution ------------------------------------------------------------
# Whether a patch may be verified by running the checkout's own test command.
#
# This is opt-in twice: this flag, and the consent on each individual run.
# In production the executor must be a container - the server refuses to
# start with this on and no container runtime available, because the local
# fallback contains the paths a checkout can reach but not the process it can
# start.
ALLOW_REPO_EXECUTION=true

# Budget for a test command, in milliseconds.
EXECUTION_TIMEOUT_MS=300000

# Budget for a dependency install, in milliseconds.
EXECUTION_SETUP_TIMEOUT_MS=600000

# --- Paths ----------------------------------------------------------------
# The SQLite database. Keep it on a persistent volume: it holds the users,
# the runs and the event history.
DATABASE_PATH=/var/lib/ci-investigator/app.db

# Where disposable checkouts are created. This is the execution boundary - a
# command will not be run outside it - so keep it on scratch space that is
# not shared with anything else.
SANDBOX_ROOT=/var/lib/ci-investigator/sandbox
