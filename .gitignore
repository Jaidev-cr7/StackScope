# Dependencies
node_modules/
dist/
*.log

# Local secrets.
#
# Every `.env*` file is ignored, with the two templates explicitly allowed
# through. `backend/.env.example` and `backend/.env.production.example` are
# the documented reference and belong in the repository; everything else -
# `backend/.env`, `backend/.env.production`, `frontend/.env.local` - is a
# local file that must never be committed.
.env*
!.env.example
!.env.production.example

# Generated by `npm run seed` from fixtures/definitions/. The definitions are
# the source of truth, so the materialised copies stay out of git.
fixtures/repos/

# Generated by `npm run fixtures:capture` from the fixture sources.
fixtures/logs/

# Written by the LLM record/replay cache and by the eval script.
.cache/
eval/results.json

# Sandbox scratch space: each run gets a temp copy of a fixture repo here.
backend/.tmp/

# The local SQLite database (users, runs, events, jobs).
backend/data/

# Working notes and internal reports. The README is the only document that
# belongs in the repository - everything under docs/ is a working artefact.
docs/
*.zip
PROJECT_STATUS_REPORT.md
PROGRESS.md
INTERVIEW_NOTES.md
TESTING.md
NOTES.md
TODO.md
SCRATCH.md

# Editor and OS noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.swp
